APP_NAME="Duely"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://keel.local
# Credential encryption key (AES-256-GCM), base64 of 32 random bytes.
# Required: SMTP/IMAP passwords are encrypted with it and are unrecoverable if it changes.
# Generate with: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_ENCRYPTION_KEY=
APP_REPO_URL=
MULTI_TENANCY_ENABLED=false
FILESYSTEM_DISK=local
FILESYSTEM_MAX_UPLOAD_MB=10
FILESYSTEM_ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,heic
ANTHROPIC_API_KEY=
# Exact model id, no date suffix. Defaults to claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
# Duely plans. The founding price id is the grandfathered $19 that the
# first fifty paying accounts are billed against for good, so a later
# rise to STRIPE_PRICE_SOLO_MONTHLY leaves them alone.
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_FOUNDING_MONTHLY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=keel
DB_USERNAME=root
DB_PASSWORD=

# otp | magic_link | both
AUTH_METHOD=both

# Mail configuration
# smtp | log
# - smtp (default): real email delivery via configured SMTP provider.
# - log: write outgoing mail to storage/logs/mail.log (useful for local dev before SMTP is set up).
#   In log mode, request an OTP or magic link and read the code/URL from that file.
MAIL_MAILER=smtp

MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Keel App"
